<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ContextMenuBuilder.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ContextMenuBuilder"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:ContextMenuBuilder"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <NavigationView
            x:Name="RootNav"
            BackRequested="RootNav_BackRequested"
            IsBackButtonVisible="Collapsed"
            IsBackEnabled="False"
            IsPaneToggleButtonVisible="False"
            OpenPaneLength="200"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavigationViewSelectionChanged">
            <NavigationView.PaneCustomContent>
                <Grid
                    x:Name="PaneLogoContent"
                    Height="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            x:Name="BackBtnWidth"
                            Width="44" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Image
                        x:Name="AppFontIcon"
                        Grid.Column="1"
                        Width="28"
                        Height="28"
                        Margin="0,0,0,4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="Assets/Square44x44Logo.png" />
                    <TextBlock
                        x:Name="AppTitle"
                        Grid.Column="2"
                        Margin="10,0,0,4"
                        Text="Menu Builder"
                        VerticalAlignment="Center" />
                </Grid>
            </NavigationView.PaneCustomContent>

            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="{x:Bind r:AppContext.AppLang.NvaHeaderMenu, Mode=OneWay}" />
                <NavigationViewItem
                    Content="{x:Bind r:AppContext.AppLang.MainNavMenuManagement, Mode=OneWay}"
                    Tag="menus">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xF2C7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="{x:Bind r:AppContext.AppLang.MainNavCertificateManagement, Mode=OneWay}"
                    Tag="certs">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xEB95;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="{x:Bind r:AppContext.AppLang.MainNavTemplateManagement, Mode=OneWay}"
                    Tag="template">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xF012;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader
                    Content="{x:Bind r:AppContext.AppLang.NvaHeaderTool, Mode=OneWay}"
                    FontFamily="Segoe Fluent Icons" />
                <NavigationViewItem
                    Content="{x:Bind r:AppContext.AppLang.Win11ShellMenuNavLabel, Mode=OneWay}"
                    Tag="win11shell">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xEDE3;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    Content="{x:Bind r:AppContext.AppLang.MainNavWizard, Mode=OneWay}"
                    Tag="wizard">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <InfoBar
            x:Name="AppInfoBar"
            Margin="0,32,8,0"
            HorizontalAlignment="Right"
            IsOpen="False"
            Message=""
            Severity="Warning" />

        <Button
            x:Name="ShellBackButton"
            Grid.Column="0"
            Width="32"
            Height="32"
            Margin="8,6,0,4"
            Padding="0"
            VerticalAlignment="Top"
            BorderThickness="0"
            Click="ShellBackButton_Click"
            IsTabStop="False"
            IsTapEnabled="False">
            <FontIcon Glyph="&#xE76B;" />
        </Button>
    </Grid>
</Window>
