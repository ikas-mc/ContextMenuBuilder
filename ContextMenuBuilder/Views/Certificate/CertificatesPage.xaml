<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ContextMenuBuilder.CertificatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ContextMenuBuilder.Core.View.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ContextMenuBuilder"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:ContextMenuBuilder"
    mc:Ignorable="d">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Header="{x:Bind r:AppContext.AppLang.CertificatesTitle, Mode=OneWay}" />

        <Pivot Grid.Row="1" SelectionChanged="Pivot_SelectionChanged">
            <PivotItem Header="{x:Bind r:AppContext.AppLang.CertificatesInfoTabTitle, Mode=OneWay}">
                <StackPanel Margin="0,8,0,0" Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind r:AppContext.AppLang.CertificatesCurrentSectionTitle, Mode=OneWay}" />
                    <Border
                        Padding="8"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="4">
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind r:AppContext.AppLang.CertificatesFileLabel, Mode=OneWay}" />
                            <TextBlock x:Name="CurrentCertPathText" TextWrapping="WrapWholeWords" />

                            <PasswordBox
                                x:Name="CurrentCertPasswordBox"
                                Header="{x:Bind r:AppContext.AppLang.CertificatesPasswordHeader, Mode=OneWay}"
                                PasswordChanged="OnCurrentPasswordChanged"
                                PlaceholderText="{x:Bind r:AppContext.AppLang.CertificatesPasswordPlaceholder, Mode=OneWay}" />
                            <CheckBox
                                x:Name="RememberPasswordCheckBox"
                                VerticalAlignment="Bottom"
                                IsEnabled="False"
                                Checked="OnRememberPasswordChanged"
                                Content="{x:Bind r:AppContext.AppLang.CertificatesRememberPassword, Mode=OneWay}"
                                Unchecked="OnRememberPasswordChanged" />

                            <Button
                                x:Name="ReloadCertButton"
                                Click="OnReloadCertClicked"
                                Content="{x:Bind r:AppContext.AppLang.CertificatesReloadButton, Mode=OneWay}" />
                            <TextBlock x:Name="CertStatusText" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="8"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="CertSubjectText" />
                            <TextBlock x:Name="CertExpireText" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    x:Name="CertInstalledText"
                                    FontWeight="Bold"
                                    Foreground="Red" />
                                <Button
                                    x:Name="InstallCurrentButton"
                                    Click="OnInstallCurrentClicked"
                                    Content="{x:Bind r:AppContext.AppLang.CertificatesInstallLocalButton, Mode=OneWay}"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="InstallWithCliButton"
                                    Click="OnInstallWithCliClicked"
                                    Content="{x:Bind r:AppContext.AppLang.CertificatesInstallCliButton, Mode=OneWay}"
                                    Visibility="Collapsed" />
                            </StackPanel>
                            <Button
                                x:Name="OpenCertManagerButton"
                                Click="OnOpenCertManagerClicked"
                                Content="{x:Bind r:AppContext.AppLang.CertificatesOpenManagerButton, Mode=OneWay}"
                                HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </PivotItem>
            <PivotItem Header="{x:Bind r:AppContext.AppLang.CertificatesImportTabTitle, Mode=OneWay}">
                <StackPanel Margin="0,8,0,0" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnPickImportPfxClicked" Content="{x:Bind r:AppContext.AppLang.CertificatesPickButton, Mode=OneWay}" />
                        <TextBlock
                            x:Name="ImportPathText"
                            Text="{x:Bind r:AppContext.AppLang.CertificatesImportNoSelection, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <PasswordBox
                        x:Name="ImportPasswordBox"
                        Header="{x:Bind r:AppContext.AppLang.CertificatesImportPasswordHeader, Mode=OneWay}"
                        PlaceholderText="{x:Bind r:AppContext.AppLang.CertificatesImportPasswordPlaceholder, Mode=OneWay}" />
                    <Button Click="OnImportCertClicked" Content="{x:Bind r:AppContext.AppLang.CertificatesImportButton, Mode=OneWay}" />
                </StackPanel>
            </PivotItem>
            <PivotItem Header="{x:Bind r:AppContext.AppLang.CertificatesCreateTabTitle, Mode=OneWay}">
                <StackPanel Margin="0,8,0,0" Spacing="8">
                    <TextBox
                        x:Name="CliSubjectBox"
                        Header="{x:Bind r:AppContext.AppLang.CertificatesSubjectHeader, Mode=OneWay}"
                        PlaceholderText="{x:Bind r:AppContext.AppLang.CertificatesSubjectPlaceholder, Mode=OneWay}" />
                    <TextBox
                        x:Name="CliValidDaysBox"
                        Header="{x:Bind r:AppContext.AppLang.CertificatesValidDaysHeader, Mode=OneWay}"
                        PlaceholderText="{x:Bind r:AppContext.AppLang.CertificatesValidDaysPlaceholder, Mode=OneWay}" />
                    <PasswordBox
                        x:Name="CliPasswordBox"
                        Header="{x:Bind r:AppContext.AppLang.CertificatesCliPasswordHeader, Mode=OneWay}"
                        PlaceholderText="{x:Bind r:AppContext.AppLang.CertificatesCliPasswordPlaceholder, Mode=OneWay}" />
                    <Button Click="OnGenerateWithCliClicked" Content="{x:Bind r:AppContext.AppLang.CertificatesCreateButton, Mode=OneWay}" />
                </StackPanel>
            </PivotItem>
        </Pivot>

        <TextBlock
            Grid.Row="2"
            Margin="8,8,8,0"
            Text="{x:Bind r:AppContext.AppLang.CertificatesOutputLabel, Mode=OneWay}" />

        <TextBox
            x:Name="OutputBox"
            Grid.Row="3"
            Height="150"
            Margin="8,8,8,8"
            AcceptsReturn="True"
            IsReadOnly="True"
            TextWrapping="Wrap" />
    </Grid>

</Page>
