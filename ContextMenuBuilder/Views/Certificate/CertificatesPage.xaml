<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ContextMenuBuilder.CertificatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ccwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:ContextMenuBuilder.Core.View.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ContextMenuBuilder"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:ContextMenuBuilder"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>

        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="2,8,0,0" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader
            Header="{x:Bind r:AppContext.AppLang.CertificatesTitle, Mode=OneWay}"
            ShowProgress="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

        <CommandBar
            Grid.Row="1"
            Margin="4,0"
            HorizontalAlignment="Stretch"
            DefaultLabelPosition="Right"
            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
            <AppBarButton
                Click="OnImportCertificateClicked"
                Label="{x:Bind r:AppContext.AppLang.CertificatesImportTitle, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind r:AppContext.AppLang.CertificatesImportTitle}">
                <AppBarButton.Icon>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE8B5;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Click="OnCreateCertificateClicked"
                Label="{x:Bind r:AppContext.AppLang.CertificatesCreateTitle, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind r:AppContext.AppLang.CertificatesCreateTitle}">
                <AppBarButton.Icon>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE710;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Click="OnReloadCertClicked"
                Label="{x:Bind r:AppContext.AppLang.CertificatesReloadButton, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind r:AppContext.AppLang.CertificatesReloadButton}">
                <AppBarButton.Icon>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE72C;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Click="OnOpenCertManagerClicked"
                Label="{x:Bind r:AppContext.AppLang.CertificatesOpenManagerButton, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE8D7;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <ScrollViewer Grid.Row="2">
            <StackPanel
                Padding="8,0,16,16"
                Spacing="{StaticResource SettingsCardSpacing}">

                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="{x:Bind r:AppContext.AppLang.CertificatesCurrentSectionTitle, Mode=OneWay}"
                    Visibility="Collapsed" />

                <ccwc:SettingsCard
                    Description="{x:Bind ViewModel.CertificateFullPath, Mode=OneWay}"
                    Header="{x:Bind r:AppContext.AppLang.CertificatesFileLabel, Mode=OneWay}">
                    <ccwc:SettingsCard.HeaderIcon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE8D7;" />
                    </ccwc:SettingsCard.HeaderIcon>
                    <TextBlock
                        MaxWidth="360"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.CertificateFileName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </ccwc:SettingsCard>

                <ccwc:SettingsCard Header="{x:Bind r:AppContext.AppLang.CertificatesSubjectLabel, Mode=OneWay}">
                    <ccwc:SettingsCard.HeaderIcon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE8A5;" />
                    </ccwc:SettingsCard.HeaderIcon>
                    <TextBlock
                        MaxWidth="360"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.SubjectText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </ccwc:SettingsCard>

                <ccwc:SettingsCard Header="{x:Bind r:AppContext.AppLang.CertificatesExpireLabel, Mode=OneWay}">
                    <ccwc:SettingsCard.HeaderIcon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE787;" />
                    </ccwc:SettingsCard.HeaderIcon>
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.ExpireText, Mode=OneWay}" />
                </ccwc:SettingsCard>

                <ccwc:SettingsCard
                    ContentAlignment="Vertical"
                    Header="{x:Bind r:AppContext.AppLang.CertificatesPasswordHeader, Mode=OneWay}">
                    <ccwc:SettingsCard.HeaderIcon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE72E;" />
                    </ccwc:SettingsCard.HeaderIcon>
                    <StackPanel Spacing="8">
                        <PasswordBox
                            x:Name="CurrentCertPasswordBox"
                            MaxWidth="400"
                            HorizontalAlignment="Left"
                            PlaceholderText="{x:Bind r:AppContext.AppLang.CertificatesPasswordPlaceholder, Mode=OneWay}" />
                        <CheckBox
                            Content="{x:Bind r:AppContext.AppLang.CertificatesRememberPassword, Mode=OneWay}"
                            IsChecked="{x:Bind ViewModel.RememberPassword, Mode=TwoWay}"
                            IsEnabled="False" />
                    </StackPanel>
                </ccwc:SettingsCard>

                <ccwc:SettingsCard
                    Description="{x:Bind ViewModel.TrustStatusText, Mode=OneWay}"
                    Header="{x:Bind r:AppContext.AppLang.CertificatesTrustLabel, Mode=OneWay}">
                    <ccwc:SettingsCard.HeaderIcon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xEA18;" />
                    </ccwc:SettingsCard.HeaderIcon>
                    <Button
                        Click="OnInstallWithCliClicked"
                        Content="{x:Bind r:AppContext.AppLang.CertificatesInstallCliButton, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.InstallButtonVisibility, Mode=OneWay}" />
                </ccwc:SettingsCard>

            </StackPanel>
        </ScrollViewer>

        <TextBlock
            Grid.Row="3"
            Margin="8,0,8,8"
            Text="{x:Bind ViewModel.Message, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsMessageOpen, Mode=OneWay}" />
    </Grid>

</Page>
