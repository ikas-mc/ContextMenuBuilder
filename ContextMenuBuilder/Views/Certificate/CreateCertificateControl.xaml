<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ContextMenuBuilder.CreateCertificateControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:ContextMenuBuilder"
    d:DesignHeight="300"
    d:DesignWidth="440"
    mc:Ignorable="d">

    <StackPanel
        MinWidth="440"
        Spacing="12">
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind _viewModel.IsMessageOpen, Mode=OneWay}"
            Message="{x:Bind _viewModel.Message, Mode=OneWay}"
            Severity="{x:Bind _viewModel.MessageSeverity, Mode=OneWay}" />
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind r:AppContext.AppLang.CertificatesCreateDialogDescription, Mode=OneWay}"
            TextWrapping="Wrap" />
        <TextBox
            x:Name="SubjectBox"
            Header="{x:Bind r:AppContext.AppLang.CertificatesSubjectHeader, Mode=OneWay}"
            PlaceholderText="{x:Bind r:AppContext.AppLang.CertificatesSubjectPlaceholder, Mode=OneWay}" />
        <TextBox
            x:Name="ValidDaysBox"
            Header="{x:Bind r:AppContext.AppLang.CertificatesValidDaysHeader, Mode=OneWay}"
            PlaceholderText="{x:Bind r:AppContext.AppLang.CertificatesValidDaysPlaceholder, Mode=OneWay}" />
        <PasswordBox
            x:Name="PasswordInput"
            Header="{x:Bind r:AppContext.AppLang.CertificatesCliPasswordHeader, Mode=OneWay}"
            PlaceholderText="{x:Bind r:AppContext.AppLang.CertificatesCliPasswordPlaceholder, Mode=OneWay}" />
    </StackPanel>

</UserControl>
