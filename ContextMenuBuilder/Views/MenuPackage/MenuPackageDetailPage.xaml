<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ContextMenuBuilder.MenuPackageDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ContextMenuBuilder.Core.View.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ContextMenuBuilder"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:ContextMenuBuilder"
    mc:Ignorable="d">
    <Page.Resources>

        <ItemsPanelTemplate x:Key="ListPanelTemplate">
            <ItemsStackPanel HorizontalAlignment="Stretch" />
        </ItemsPanelTemplate>

    </Page.Resources>
    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader
            x:Name="PageHeader"
            Grid.Row="0"
            Header="{x:Bind r:AppContext.AppLang.MenuPackageDetailTitle, Mode=OneWay}" />

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="8">
            <Button Click="OnRefreshClicked" Content="{x:Bind r:AppContext.AppLang.MenuPackageDetailRefreshButton, Mode=OneWay}" />
            <Button Click="OnNewClicked" Content="{x:Bind r:AppContext.AppLang.MenuPackageDetailNewButton, Mode=OneWay}" />
            <Button Click="OnDeleteClicked" Content="{x:Bind r:AppContext.AppLang.MenuPackageDetailDeleteButton, Mode=OneWay}" />
            <Button Click="OnOpenClicked" Content="{x:Bind r:AppContext.AppLang.MenuPackageDetailOpenEditorButton, Mode=OneWay}" />
            <Button
                Margin="16,0,0,0"
                Click="OnBackupClicked"
                Content="{x:Bind r:AppContext.AppLang.MenuPackageDetailBackupButton, Mode=OneWay}" />
            <Button Click="OnSyncClicked" Content="{x:Bind r:AppContext.AppLang.MenuPackageDetailRestoreButton, Mode=OneWay}" />
            <Button
                Click="FolderText_Click"
                x:Name="FolderText"
                 />
        </StackPanel>

        <Grid
            Grid.Row="2"
            ColumnDefinitions="2*,3*"
            ColumnSpacing="12"
            RowDefinitions="Auto,*"
            RowSpacing="8">
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                FontWeight="SemiBold"
                Text="{x:Bind r:AppContext.AppLang.MenuPackageDetailMenuListLabel, Mode=OneWay}" />
            <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                FontWeight="SemiBold"
                Text="{x:Bind r:AppContext.AppLang.MenuPackageDetailEditorLabel, Mode=OneWay}" />

            <GridView
                x:Name="MenuList"
                Grid.Row="1"
                Grid.Column="0"
                ItemContainerStyle="{StaticResource YukiGridViewItemStyle}"
                ItemsPanel="{StaticResource ListPanelTemplate}"
                SelectionChanged="OnMenuSelectionChanged">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:MenuConfigItem">
                        <Grid Padding="8">
                            <TextBlock Text="{x:Bind DisplayText, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <StackPanel
                Grid.Row="1"
                Grid.Column="1"
                Spacing="8">
                <TextBox x:Name="MenuFileNameBox" PlaceholderText="{x:Bind r:AppContext.AppLang.MenuPackageDetailFileNamePlaceholder, Mode=OneWay}" />
                <TextBox
                    x:Name="ContentBox"
                    Height="320"
                    AcceptsReturn="True"
                    PlaceholderText="{x:Bind r:AppContext.AppLang.MenuPackageDetailContentPlaceholder, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Button Click="OnSaveClicked" Content="{x:Bind r:AppContext.AppLang.MenuPackageDetailSaveButton, Mode=OneWay}" />
            </StackPanel>
        </Grid>
        <TextBlock
            x:Name="StatusText"
            Grid.Row="3"
            VerticalAlignment="Center" />
    </Grid>
</Page>
