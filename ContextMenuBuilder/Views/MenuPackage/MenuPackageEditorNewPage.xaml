<Page
    x:Class="ContextMenuBuilder.MenuPackageEditorNewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:ContextMenuBuilder"
    xmlns:controls="using:ContextMenuBuilder.Core.View.Controls"
    mc:Ignorable="d">

    <Grid RowSpacing="8" Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader
            Header="{x:Bind r:AppContext.AppLang.MenuPackageEditorTitle, Mode=OneWay}" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
                <TextBox
                    x:Name="InputFolderText"
                    FontSize="12"
                    Header="{x:Bind r:AppContext.AppLang.MenuPackageEditorInputFolderLabel, Mode=OneWay}"
                    IsReadOnly="True"
                    TextWrapping="Wrap" />

                <TextBox
                    x:Name="PackageIdBox"
                    Header="{x:Bind r:AppContext.AppLang.MenuPackageEditorPackageIdLabel, Mode=OneWay}" />

                <TextBox
                    x:Name="VersionBox"
                    Header="{x:Bind r:AppContext.AppLang.MenuPackageEditorVersionLabel, Mode=OneWay}"
                    PlaceholderText="{x:Bind r:AppContext.AppLang.MenuPackageEditorVersionPlaceholder, Mode=OneWay}" />

                <TextBox
                    x:Name="AppDisplayNameBox"
                    Header="{x:Bind r:AppContext.AppLang.MenuPackageEditorDisplayNameLabel, Mode=OneWay}"
                    PlaceholderText="{x:Bind r:AppContext.AppLang.MenuPackageEditorDisplayNamePlaceholder, Mode=OneWay}" />

                <CheckBox
                    x:Name="StartMenuCheckBox"
                    Content="{x:Bind r:AppContext.AppLang.MenuPackageEditorStartMenu, Mode=OneWay}"
                    IsChecked="True" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Click="OnGenerateClicked"
                        Content="{x:Bind r:AppContext.AppLang.MenuPackageEditorGenerateButton, Mode=OneWay}" />
                    <Button
                        Click="OnInstallClicked"
                        Content="{x:Bind r:AppContext.AppLang.MenuPackageEditorInstallButton, Mode=OneWay}" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{x:Bind r:AppContext.AppLang.MenuPackageEditorOutputLabel, Mode=OneWay}" />
                <TextBox
                    x:Name="OutputBox"
                    Height="240"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
