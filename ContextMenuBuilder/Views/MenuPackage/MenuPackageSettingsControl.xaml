<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ContextMenuBuilder.MenuPackageSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ccwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="440"
    mc:Ignorable="d">

    <StackPanel Spacing="4">

        <ccwc:SettingsCard
            Description="{x:Bind _appLang.MenuPackageSettingsMenuNameDescription}"
            Header="{x:Bind _appLang.MenuPackageSettingsMenuNameHeader}">
            <ccwc:SettingsCard.HeaderIcon>
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    Glyph="&#xEDE3;" />
            </ccwc:SettingsCard.HeaderIcon>
            <TextBox
                x:Name="MenuNameTextBox"
                MinWidth="300"
                MaxLength="64"
                PlaceholderText="{x:Bind _appLang.MenuPackageSettingsMenuNamePlaceholder}"
                Text="{x:Bind MenuName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </ccwc:SettingsCard>

        <ccwc:SettingsCard Header="{x:Bind _appLang.MenuPackageSettingsLightIconHeader}">
            <ccwc:SettingsCard.HeaderIcon>
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    Glyph="&#xE8B9;" />
            </ccwc:SettingsCard.HeaderIcon>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="*"
                        MinWidth="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="LightIconTextBox"
                    Grid.Column="0"
                    MinWidth="300"
                    VerticalAlignment="Center"
                    Text="{x:Bind LightIcon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Click="Browse_Click"
                    Tag="Light"
                    ToolTipService.ToolTip="{x:Bind _appLang.MenuPackageSettingsBrowseButton}">
                    <SymbolIcon Symbol="OpenFile" />
                </Button>
                <Button
                    Grid.Column="2"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Click="Clear_Click"
                    Tag="Light"
                    ToolTipService.ToolTip="{x:Bind _appLang.MenuPackageSettingsClearButton}">
                    <SymbolIcon Symbol="Delete" />
                </Button>
            </Grid>
        </ccwc:SettingsCard>

        <ccwc:SettingsCard Header="{x:Bind _appLang.MenuPackageSettingsDarkIconHeader}">
            <ccwc:SettingsCard.HeaderIcon>
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    Glyph="&#xE708;" />
            </ccwc:SettingsCard.HeaderIcon>
            <Grid
                HorizontalAlignment="Stretch"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="*"
                        MinWidth="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="DarkIconTextBox"
                    Grid.Column="0"
                    MinWidth="300"
                    VerticalAlignment="Center"
                    Text="{x:Bind DarkIcon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Click="Browse_Click"
                    Tag="Dark"
                    ToolTipService.ToolTip="{x:Bind _appLang.MenuPackageSettingsBrowseButton}">
                    <SymbolIcon Symbol="OpenFile" />
                </Button>
                <Button
                    Grid.Column="2"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Click="Clear_Click"
                    Tag="Dark"
                    ToolTipService.ToolTip="{x:Bind _appLang.MenuPackageSettingsClearButton}">
                    <SymbolIcon Symbol="Delete" />
                </Button>
            </Grid>
        </ccwc:SettingsCard>

        <TextBlock
            Margin="12,4,12,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind _appLang.MenuPackageSettingsIconTip}"
            TextWrapping="Wrap" />

    </StackPanel>
</UserControl>
