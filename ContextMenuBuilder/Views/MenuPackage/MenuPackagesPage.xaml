<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ContextMenuBuilder.MenuPackagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ContextMenuBuilder.Core.View.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ContextMenuBuilder"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:ContextMenuBuilder"
    mc:Ignorable="d">
    <Page.Resources>

        <ItemsPanelTemplate x:Key="ListPanelTemplate">
            <ItemsStackPanel HorizontalAlignment="Stretch" />
        </ItemsPanelTemplate>

        <MenuFlyout
            x:Key="ContextMenu"
            x:Name="ContextMenu">
            <MenuFlyoutItem
                Click="ContextMenu_Click"
                Tag="menus"
                Text="{x:Bind r:AppContext.AppLang.MenuPackageOpenMenusButton, Mode=OneWay}">
                <MenuFlyoutItem.Icon>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE71D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                Click="ContextMenu_Click"
                Tag="upgrade"
                Text="{x:Bind r:AppContext.AppLang.MenuPackageUpgradeButton, Mode=OneWay}">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="PostUpdate" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="ContextMenu_Click"
                Tag="open"
                Text="{x:Bind r:AppContext.AppLang.MenuPackageOpenButton, Mode=OneWay}">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="OpenFile" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="ContextMenu_Click"
                Tag="delete"
                Text="{x:Bind r:AppContext.AppLang.MenuPackageUninstallButton, Mode=OneWay}">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Remove" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

    </Page.Resources>
    <Grid RowSpacing="8">
        <Grid.ColumnDefinitions />

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Header="{x:Bind r:AppContext.AppLang.MenuPackagesTitle, Mode=OneWay}" />

        <StackPanel
            Grid.Row="1"
            Margin="8,0,8,0"
            Orientation="Horizontal"
            Spacing="8">
            <TextBox
                x:Name="PrefixBox"
                Width="320"
                PlaceholderText="{x:Bind r:AppContext.AppLang.MenuPackagePrefixPlaceholder, Mode=OneWay}" />
            <Button
                Margin="0,0,0,-1"
                VerticalAlignment="Bottom"
                Click="OnQueryClicked"
                Content="{x:Bind r:AppContext.AppLang.MenuPackageQueryButton, Mode=OneWay}" />
        </StackPanel>

        <CommandBar
            Grid.Row="2"
            Margin="4,0"
            HorizontalAlignment="Left"
            DefaultLabelPosition="Right">
            <CommandBar.PrimaryCommands>
                <AppBarButton
                    Click="OnAddClicked"
                    Icon="Add"
                    Label="{x:Bind r:AppContext.AppLang.MenuPackageAddButton, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind r:AppContext.AppLang.MenuPackageAddButton}" />
            </CommandBar.PrimaryCommands>
        </CommandBar>

        <GridView
            x:Name="PackagesList"
            Grid.Row="3"
            Margin="8,0,0,0"
            Padding="0,0,8,0"
            ContextRequested="PackagesList_ContextRequested"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            ItemContainerStyle="{StaticResource YukiGridViewItemStyle}"
            ItemsPanel="{StaticResource ListPanelTemplate}"
            ItemsSource="{x:Bind _packages, Mode=OneWay}"
            SelectionChanged="OnSelectionChanged"
            SelectionMode="Single">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:MenuPackageView">
                    <Grid
                        Padding="8"
                        ColumnSpacing="8"
                        RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>
                        <FontIcon
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xECAA;" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            FontWeight="SemiBold"
                            Text="{x:Bind ApplicationDisplayName}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            FontSize="12"
                            Text="{x:Bind IdFullName}" />

                        <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="4"
                            Width="32"
                            Padding="4"
                            Background="{x:Null}"
                            BorderBrush="{x:Null}"
                            Click="ContextMenuButton_Click">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xE712;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="4"
            Margin="8"
            VerticalAlignment="Bottom" />
    </Grid>
</Page>
