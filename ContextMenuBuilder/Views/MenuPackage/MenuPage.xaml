<Page
    x:Class="ContextMenuBuilder.MenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cmcam="using:ContextMenuCustomApp.View.Menu"
    xmlns:common="using:ContextMenuCustomApp.View.Common"
    xmlns:controls="using:ContextMenuCustomApp.View.Controls"
    xmlns:controls1="using:ContextMenuBuilder.Core.View.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ContextMenuBuilder"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:menu="using:ContextMenuCustomApp.Service.Menu"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls1:PageHeader
            x:Name="PageHeader"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            ShowProgress="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

        <CommandBar
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Left"
            DefaultLabelPosition="Right">
            <CommandBar.PrimaryCommands>
                <AppBarButton
                    Click="Add_Click"
                    Icon="Add"
                    Label="{x:Bind AppLang.MenuListAdd, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind AppLang.MenuListAddTis}" />
                <AppBarButton
                    Click="Refresh_Click"
                    Icon="Refresh"
                    Label="{x:Bind AppLang.MenuListRefresh, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind AppLang.MenuListRefreshTips}">

                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton
                    Click="Open_Folder_Click"
                    Icon="OpenFile"
                    Label="{x:Bind AppLang.MenuListOpenFolder, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind AppLang.MenuListOpenFolderTips}" />


                <AppBarSeparator />

