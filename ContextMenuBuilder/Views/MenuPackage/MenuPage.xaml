                <AppBarSeparator />
                <AppBarButton
                    Click="OnOpenClicked"
                    Icon="OpenWith"
                    Label="{x:Bind AppLang.MenuPackageDetailOpenEditorButton, Mode=OneWay}" />

            </CommandBar.PrimaryCommands>
        </CommandBar>

        <ListView
            x:Name="CommandList"
            Grid.Row="2"
            Grid.Column="0"
            AllowDrop="False"
            BorderBrush="{ThemeResource NavContentBorderColor}"
            BorderThickness="0,0,1,0"
            CanDragItems="False"
            CanReorderItems="False"
            ItemsSource="{x:Bind ViewModel.MenuItems, Mode=OneWay}"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="menu:MenuItem">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Grid.Column="0"
                            Width="24"
                            Height="24"
                            local:MenuItemIconLoader.Source="{x:Bind Icon, Mode=OneWay}"
                            Stretch="Uniform" />

                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}" />

                        <FontIcon
                            Grid.Column="2"
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xF140;"
                            Visibility="{x:Bind Enabled, Mode=OneWay, Converter={StaticResource EqualsVisibilityConverter}, ConverterParameter=False}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid
            Grid.Row="2"
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="0" />
                <RowDefinition Height="*" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="4,-8,0,0"
                FontSize="28"
                Text="Menu"
                Visibility="Collapsed" />

            <cmcam:MenuEditorControl
                Grid.Row="1"
                Grid.Column="2"
                Margin="0"
                Padding="4,4,16,4"
                MenuItem="{x:Bind (menu:MenuItem)CommandList.SelectedItem, Mode=OneWay}"
                Visibility="{x:Bind CommandList.SelectedItem, Mode=OneWay, Converter={StaticResource VisibilityConverter}}" />

            <Grid
                Grid.Row="1"
                Grid.Column="2"
                Padding="0"
                HorizontalAlignment="Center"
                Visibility="{x:Bind CommandList.SelectedItem, Mode=OneWay, Converter={StaticResource VisibilityConverter}, ConverterParameter=!}">
                <Button
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    Click="Add_Click"
                    Content="{x:Bind AppLang.MenuListAdd}" />
            </Grid>

            <CommandBar
                Grid.Row="2"
                DefaultLabelPosition="Right">
                <CommandBar.PrimaryCommands>
                    <AppBarButton
                        Click="OpenHelp_Click"
                        Icon="Globe"
                        Label="{x:Bind AppLang.MenuCommandHelp}"
                        ToolTipService.ToolTip="{x:Bind AppLang.MenuCommandHelpTips}" />

                    <AppBarSeparator />

                    <AppBarButton
                        Click="CopyToClipboard_Click"
                        Icon="Copy"
                        Label="{x:Bind AppLang.MenuCommandClipboardCopy}"
                        ToolTipService.ToolTip="{x:Bind AppLang.MenuCommandClipboardCopyTips}" />

                    <AppBarButton
                        Click="CopyFromClipboard_Click"
                        Icon="Paste"
                        Label="{x:Bind AppLang.MenuCommandClipboardPaste}"
                        ToolTipService.ToolTip="{x:Bind AppLang.MenuCommandClipboardPasteTips}" />
                    <AppBarSeparator />

                    <AppBarButton
                        Click="Open_Click"
                        Icon="OpenFile"
                        Label="{x:Bind AppLang.MenuCommandOpen}"
                        ToolTipService.ToolTip="{x:Bind AppLang.MenuCommandOpenTips}" />

                    <AppBarButton
                        Click="Rename_Click"
                        Icon="Rename"
                        Label="{x:Bind AppLang.MenuCommandRename}"
                        ToolTipService.ToolTip="{x:Bind AppLang.MenuCommandRenameTips}" />

                    <AppBarButton
                        Click="Enable_Click"
                        Label="{x:Bind AppLang.MenuCommandToggleEnabled}"
                        ToolTipService.ToolTip="{x:Bind AppLang.MenuCommandToggleEnabledTips}">
                        <AppBarButton.Icon>
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xE733;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        Click="Delete_Click"
                        Icon="Delete"
                        Label="{x:Bind AppLang.MenuCommandDelete}"
                        ToolTipService.ToolTip="{x:Bind AppLang.MenuCommandDeleteTips}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Delete" />
                        </Button.KeyboardAccelerators>
                    </AppBarButton>

                    <AppBarButton
                        Click="Save_Click"
                        Icon="Save"
                        Label="{x:Bind AppLang.MenuCommandSave}"
                        ToolTipService.ToolTip="{x:Bind AppLang.MenuCommandSaveTips}">
                        <AppBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator
                                Key="S"
                                Modifiers="Control" />
                        </AppBarButton.KeyboardAccelerators>
                    </AppBarButton>

                    <AppBarButton
                        Click="Refresh_Menu_Click"
                        Icon="Refresh"
                        Label="{x:Bind AppLang.MenuCommandRefresh}"
                        ToolTipService.ToolTip="{x:Bind AppLang.MenuCommandRefreshTips}" />
                </CommandBar.PrimaryCommands>
            </CommandBar>
        </Grid>
    </Grid>
</Page>