<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ContextMenuBuilder.Views.MenuPackage.PackageList.MenuPackagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ContextMenuBuilder.Core.View.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:ContextMenuBuilder"
    xmlns:svc="using:ContextMenuBuilder.Service.MenuPackage"
    mc:Ignorable="d">
    <Page.Resources>

        <ItemsPanelTemplate x:Key="ListPanelTemplate">
            <ItemsStackPanel HorizontalAlignment="Stretch" />
        </ItemsPanelTemplate>

        <MenuFlyout
            x:Key="ContextMenu"
            x:Name="ContextMenu">
            <MenuFlyoutItem
                Click="ContextMenu_Click"
                Tag="menus"
                Text="{x:Bind r:AppContext.AppLang.MenuPackageOpenMenusButton, Mode=OneWay}">
                <MenuFlyoutItem.Icon>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE71D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                Click="ContextMenu_Click"
                Tag="upgrade"
                Text="{x:Bind r:AppContext.AppLang.MenuPackageUpgradeButton, Mode=OneWay}">
                <MenuFlyoutItem.Icon>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE895;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="ContextMenu_Click"
                Tag="open"
                Text="{x:Bind r:AppContext.AppLang.MenuPackageOpenButton, Mode=OneWay}">
                <MenuFlyoutItem.Icon>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE768;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="ContextMenu_Click"
                Tag="delete"
                Text="{x:Bind r:AppContext.AppLang.MenuPackageUninstallButton, Mode=OneWay}">
                <MenuFlyoutItem.Icon>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

    </Page.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader
            Header="{x:Bind r:AppContext.AppLang.MenuPackagesTitle, Mode=OneWay}"
            ShowProgress="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

        <Grid
            Grid.Row="1"
            Margin="8,0,8,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="PrefixBox"
                Grid.Column="0"
                MinWidth="260"
                VerticalAlignment="Center"
                KeyDown="OnPrefixKeyDown"
                PlaceholderText="{x:Bind r:AppContext.AppLang.MenuPackagePrefixPlaceholder, Mode=OneWay}" />
            <AppBarButton
                Grid.Column="1"
                Width="40"
                Click="OnQueryClicked"
                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                LabelPosition="Collapsed">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="16"
                    Glyph="&#xE721;" />
            </AppBarButton>

            <CommandBar
                Grid.Column="2"
                HorizontalAlignment="Right"
                DefaultLabelPosition="Right"
                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                <AppBarButton
                    Click="OnAddClicked"
                    Label="{x:Bind r:AppContext.AppLang.MenuPackageAddButton, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind r:AppContext.AppLang.MenuPackageAddButton}">
                    <AppBarButton.Icon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE710;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    Click="OnQueryClicked"
                    Label="{x:Bind r:AppContext.AppLang.MenuPackageRefreshButton, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind r:AppContext.AppLang.MenuPackageRefreshButton}">
                    <AppBarButton.Icon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE72C;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton
                    Click="OnOpenMenusClicked"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                    Label="{x:Bind r:AppContext.AppLang.MenuPackageOpenMenusButton, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind r:AppContext.AppLang.MenuPackageOpenMenusButton}">
                    <AppBarButton.Icon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE71D;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    Click="OnOpenClicked"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                    Label="{x:Bind r:AppContext.AppLang.MenuPackageOpenButton, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind r:AppContext.AppLang.MenuPackageOpenButton}">
                    <AppBarButton.Icon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE768;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    Click="OnUpgradeClicked"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                    Label="{x:Bind r:AppContext.AppLang.MenuPackageUpgradeButton, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind r:AppContext.AppLang.MenuPackageUpgradeButton}">
                    <AppBarButton.Icon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE895;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    Click="OnUninstallClicked"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                    Label="{x:Bind r:AppContext.AppLang.MenuPackageUninstallButton, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind r:AppContext.AppLang.MenuPackageUninstallButton}">
                    <AppBarButton.Icon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE74D;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>
        <GridView
            x:Name="PackagesList"
            Grid.Row="3"
            Margin="8,0,0,0"
            Padding="0,0,8,0"
            ContextRequested="PackagesList_ContextRequested"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            ItemContainerStyle="{StaticResource YukiGridViewItemStyle}"
            ItemsPanel="{StaticResource ListPanelTemplate}"
            ItemsSource="{x:Bind ViewModel.Packages, Mode=OneWay}"
            SelectionMode="Single">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="svc:MenuPackageInfo">
                    <Grid
                        Padding="8"
                        ColumnSpacing="8"
                        RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>
                        <FontIcon
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xECAA;" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            FontWeight="SemiBold"
                            Text="{x:Bind ApplicationDisplayName}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            FontSize="12"
                            Text="{x:Bind IdFullName}" />

                        <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="2"
                            Width="32"
                            Padding="4"
                            Background="{x:Null}"
                            BorderBrush="{x:Null}"
                            Click="ContextMenuButton_Click">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xE712;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <TextBlock
            Grid.Row="4"
            Margin="8,0,8,8"
            Text="{x:Bind ViewModel.Message, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.IsMessageOpen, Mode=OneWay}" />
    </Grid>
</Page>
