<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ContextMenuBuilder.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ccwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:ContextMenuBuilder.Core.View.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="using:ContextMenuBuilder.Modules.Lang"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:ContextMenuBuilder"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  These styles can be referenced to create a consistent SettingsPage layout  -->

        <!--  Spacing between cards  -->
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>

        <!--  Style (inc. the correct spacing) of a section header  -->
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="2,8,0,0" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Header="{x:Bind r:AppContext.AppLang.SettingsTitle, Mode=OneWay}" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="8,8,16,16" Spacing="12">
                <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                    <ccwc:SettingsCard Header="{x:Bind r:AppContext.AppLang.SettingsWinAppCliHeader, Mode=OneWay}">
                        <ccwc:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEC7A;" />
                        </ccwc:SettingsCard.HeaderIcon>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="WinAppCliPathBox"
                                MinWidth="300"
                                Margin="0,0,8,0"
                                Text="{x:Bind r:AppContext.AppSettings.WinAppCliPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                Width="40"
                                Click="OnPickWinAppCliPathClicked">
                                <SymbolIcon Symbol="OpenFile" />
                            </Button>
                        </Grid>
                    </ccwc:SettingsCard>

                    <ccwc:SettingsCard Header="{x:Bind r:AppContext.AppLang.SettingsMenuPackagePrefixHeader, Mode=OneWay}">
                        <ccwc:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE773;" />
                        </ccwc:SettingsCard.HeaderIcon>
                        <TextBox
                            x:Name="MenuPackagePrefixBox"
                            MinWidth="300"
                            Text="{x:Bind r:AppContext.AppSettings.MenuPackageIdPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </ccwc:SettingsCard>

                    <ccwc:SettingsCard Header="{x:Bind r:AppContext.AppLang.SettingsMenuBackupRootHeader, Mode=OneWay}">
                        <ccwc:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE96A;" />
                        </ccwc:SettingsCard.HeaderIcon>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="MenuConfigRootBox"
                                MinWidth="300"
                                MaxWidth="400"
                                Margin="0,0,8,0"
                                Text="{x:Bind r:AppContext.AppSettings.MenuBackupPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                Width="40"
                                Click="OnPickMenuConfigRootClicked">
                                <SymbolIcon Symbol="OpenFile" />
                            </Button>
                        </Grid>
                    </ccwc:SettingsCard>

                    <ccwc:SettingsCard Header="{x:Bind r:AppContext.AppLang.SettingsMenuInputRootHeader, Mode=OneWay}">
                        <ccwc:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF012;" />
                        </ccwc:SettingsCard.HeaderIcon>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="MenuPackageInputRootBox"
                                MinWidth="300"
                                MaxWidth="400"
                                Margin="0,0,8,0"
                                Text="{x:Bind r:AppContext.AppSettings.MenuPackageTemplatePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                Width="40"
                                Click="OnPickMenuPackageInputRootClicked">
                                <SymbolIcon Symbol="OpenFile" />
                            </Button>
                        </Grid>
                    </ccwc:SettingsCard>
                </StackPanel>



                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Bind r:AppContext.AppLang.SettingLanguagesGroup}" />


                <ccwc:SettingsExpander Header="{x:Bind r:AppContext.AppLang.SettingLanguages}" IsExpanded="False">
                    <ccwc:SettingsExpander.HeaderIcon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF2B7;" />
                    </ccwc:SettingsExpander.HeaderIcon>
                    <!--
 <ccwc:SettingsExpander.Description>
     <HyperlinkButton
         Grid.Row="1"
         Grid.Column="0"
         Margin="-2,0,0,0"
         Padding="0"
         HorizontalAlignment="Left"
         Content="{x:Bind r:AppContext.AppLang.SettingLanguagesHelp}"
         NavigateUri="https://github.com/ikas-mc/ContextMenuForWindows11/wiki/Languages" />
 </ccwc:SettingsExpander.Description>
                    -->
                    <ccwc:SettingsExpander.Items>
                        <ccwc:SettingsCard>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox
                                    x:Name="LanguageOverrideComboBox"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind _settingViewModel.Languages, Mode=OneWay}"
                                    PlaceholderText="-">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="lang:LangInfo">
                                            <TextBlock>
                                                <Run Text="{x:Bind DisplayName, Mode=OneWay}" />
                                                <Run Text=" (" />
                                                <Run Text="{x:Bind FileName, Mode=OneWay}" />
                                                <Run Text=")" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button
                                    Grid.Column="2"
                                    Width="56"
                                    Margin="4,0,0,0"
                                    Click="{x:Bind _settingViewModel.LoadLanguages}"
                                    ToolTipService.ToolTip="{x:Bind r:AppContext.AppLang.SettingLanguagesReloadTip}">
                                    <SymbolIcon Symbol="Refresh" />
                                </Button>

                            </StackPanel>
                        </ccwc:SettingsCard>
                        <ccwc:SettingsCard>
                            <StackPanel Orientation="Horizontal">

                                <Button
                                    Width="56"
                                    Margin="4,0,0,0"
                                    Click="ExportButton_Click"
                                    ToolTipService.ToolTip="{x:Bind r:AppContext.AppLang.SettingLanguagesExportTip}">
                                    <SymbolIcon Symbol="Download" />
                                </Button>
                                <Button
                                    Width="56"
                                    Margin="4,0,0,0"
                                    Click="ImportButton_Click"
                                    ToolTipService.ToolTip="{x:Bind r:AppContext.AppLang.SettingLanguagesImportTip}">
                                    <SymbolIcon Symbol="Add" />
                                </Button>
                            </StackPanel>
                        </ccwc:SettingsCard>
                    </ccwc:SettingsExpander.Items>
                </ccwc:SettingsExpander>

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Bind r:AppContext.AppLang.AppSettingData}" />


                <ccwc:SettingsExpander Header="{x:Bind r:AppContext.AppLang.SavedData}" IsExpanded="False">
                    <ccwc:SettingsExpander.HeaderIcon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF12B;" />
                    </ccwc:SettingsExpander.HeaderIcon>
                    <ccwc:SettingsExpander.Items>
                        <ccwc:SettingsCard>
                            <Button
                                x:Name="OpenDataFolderBtn"
                                Click="OpenDataFolderBtn_Click"
                                Content="{x:Bind r:AppContext.AppLang.SettingOpenSavedDataFolder}" />
                        </ccwc:SettingsCard>

                    </ccwc:SettingsExpander.Items>
                </ccwc:SettingsExpander>

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Bind r:AppContext.AppLang.SettingOtherSectionTitle}" />

                <ccwc:SettingsCard Header="{x:Bind r:AppContext.AppLang.RestartAppLabel}">
                    <ccwc:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF83E;" />
                    </ccwc:SettingsCard.HeaderIcon>
                    <Button
                        Width="160"
                        Click="RestartAppButton_Click"
                        Content="{x:Bind r:AppContext.AppLang.RestartAppLabel}" />
                </ccwc:SettingsCard>

                <TextBlock Margin="2,8,0,0">
                    <Run Text="{x:Bind r:AppContext.AppLang.SettingAboutVersionLabel, Mode=OneWay}" />
                    <Run Text=": " />
                    <Run Text="{x:Bind _settingViewModel.AppVersion(), Mode=OneWay}" />
                </TextBlock>
                <HyperlinkButton
                    Margin="2,0,0,8"
                    Padding="0"
                    Content="ikas@2026"
                    NavigateUri="{x:Bind _settingViewModel.ProjectHomepage, Mode=OneWay}" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
