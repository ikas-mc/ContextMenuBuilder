<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ContextMenuBuilder.ImportTemplateControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:ContextMenuBuilder"
    d:DesignHeight="200"
    d:DesignWidth="440"
    mc:Ignorable="d">

    <StackPanel
        MinWidth="440"
        Spacing="12">
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind _viewModel.IsMessageOpen, Mode=OneWay}"
            Message="{x:Bind _viewModel.Message, Mode=OneWay}"
            Severity="{x:Bind _viewModel.MessageSeverity, Mode=OneWay}" />
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind r:AppContext.AppLang.TemplateImportInstruction, Mode=OneWay}"
            TextWrapping="Wrap" />
        <StackPanel
            Orientation="Horizontal"
            Spacing="8">
            <Button Click="OnPickClicked">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="16"
                        Glyph="&#xE8E5;" />
                    <TextBlock Text="{x:Bind r:AppContext.AppLang.TemplatePickFileButton, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Bind _viewModel.ImportFileName, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <HyperlinkButton
            Click="OnDownloadClicked"
            Content="{x:Bind r:AppContext.AppLang.TemplateDownloadButton, Mode=OneWay}" />
    </StackPanel>

</UserControl>
