<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ContextMenuBuilder.TemplatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ccwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:ContextMenuBuilder.Core.View.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ContextMenuBuilder"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:ContextMenuBuilder"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>

        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="2,8,0,0" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader
            Header="{x:Bind r:AppContext.AppLang.TemplateTitle, Mode=OneWay}"
            ShowProgress="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

        <CommandBar
            Grid.Row="1"
            Margin="4,0"
            HorizontalAlignment="Stretch"
            DefaultLabelPosition="Right"
            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
            <AppBarButton
                Click="OnImportTemplateClicked"
                Label="{x:Bind r:AppContext.AppLang.TemplateImportTitle, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind r:AppContext.AppLang.TemplateImportTitle}">
                <AppBarButton.Icon>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE8B5;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Click="OnReloadClicked"
                Label="{x:Bind r:AppContext.AppLang.TemplateReloadButton, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind r:AppContext.AppLang.TemplateReloadButton}">
                <AppBarButton.Icon>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE72C;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Click="OnOpenTemplateFolderClicked"
                Label="{x:Bind r:AppContext.AppLang.TemplateOpenFolderButton, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind r:AppContext.AppLang.TemplateOpenFolderButton}">
                <AppBarButton.Icon>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE838;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Click="OnDownloadTemplateClicked"
                Label="{x:Bind r:AppContext.AppLang.TemplateDownloadButton, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind r:AppContext.AppLang.TemplateDownloadButton}">
                <AppBarButton.Icon>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE896;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <ScrollViewer Grid.Row="2">
            <StackPanel
                Padding="8,0,16,16"
                Spacing="{StaticResource SettingsCardSpacing}">

                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="{x:Bind r:AppContext.AppLang.TemplateSectionTitle, Mode=OneWay}"
                    Visibility="Collapsed" />

                <ccwc:SettingsCard
                    Description="{x:Bind ViewModel.TemplateFolderPath, Mode=OneWay}"
                    Header="{x:Bind r:AppContext.AppLang.TemplateFolderLabel, Mode=OneWay}">
                    <ccwc:SettingsCard.HeaderIcon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE838;" />
                    </ccwc:SettingsCard.HeaderIcon>
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.TemplateStateText, Mode=OneWay}" />
                </ccwc:SettingsCard>

                <ccwc:SettingsCard Header="{x:Bind r:AppContext.AppLang.TemplateInfoDisplayNameLabel, Mode=OneWay}">
                    <ccwc:SettingsCard.HeaderIcon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE8A5;" />
                    </ccwc:SettingsCard.HeaderIcon>
                    <TextBlock
                        MaxWidth="360"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.DisplayNameText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </ccwc:SettingsCard>

                <ccwc:SettingsCard Header="{x:Bind r:AppContext.AppLang.TemplateInfoIdentityLabel, Mode=OneWay}">
                    <ccwc:SettingsCard.HeaderIcon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE8F1;" />
                    </ccwc:SettingsCard.HeaderIcon>
                    <TextBlock
                        MaxWidth="360"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.IdentityNameText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </ccwc:SettingsCard>

                <ccwc:SettingsCard Header="{x:Bind r:AppContext.AppLang.TemplatePublisherLabel, Mode=OneWay}">
                    <ccwc:SettingsCard.HeaderIcon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE77B;" />
                    </ccwc:SettingsCard.HeaderIcon>
                    <TextBlock
                        MaxWidth="360"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.PublisherText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </ccwc:SettingsCard>

                <ccwc:SettingsCard Header="{x:Bind r:AppContext.AppLang.TemplateVersionLabel, Mode=OneWay}">
                    <ccwc:SettingsCard.HeaderIcon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE946;" />
                    </ccwc:SettingsCard.HeaderIcon>
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.VersionText, Mode=OneWay}" />
                </ccwc:SettingsCard>

                <ccwc:SettingsCard Header="{x:Bind r:AppContext.AppLang.TemplateArchitectureLabel, Mode=OneWay}">
                    <ccwc:SettingsCard.HeaderIcon>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE713;" />
                    </ccwc:SettingsCard.HeaderIcon>
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.ArchitectureText, Mode=OneWay}" />
                </ccwc:SettingsCard>

            </StackPanel>
        </ScrollViewer>

        <TextBlock
            Grid.Row="3"
            Margin="8,0,8,8"
            Text="{x:Bind ViewModel.Message, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsMessageOpen, Mode=OneWay}" />
    </Grid>

</Page>
