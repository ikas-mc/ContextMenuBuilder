<Page
    x:Class="ContextMenuBuilder.TemplatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ContextMenuBuilder.Core.View.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ContextMenuBuilder"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:ContextMenuBuilder"
    mc:Ignorable="d">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Header="{x:Bind r:AppContext.AppLang.TemplateTitle, Mode=OneWay}" />

        <Pivot Grid.Row="1" SelectionChanged="OnPivotSelectionChanged">
            <PivotItem Header="{x:Bind r:AppContext.AppLang.TemplateInfoTabTitle, Mode=OneWay}">

                <StackPanel Margin="0,8,0,0" Spacing="8">
                    <TextBlock x:Name="InfoStatusText" TextWrapping="Wrap" />
                    <Border
                        Padding="8"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="4">
                        <StackPanel
                            x:Name="ManifestInfoPanel"
                            Spacing="4"
                            Visibility="Collapsed">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind r:AppContext.AppLang.TemplateInfoIdentityLabel, Mode=OneWay}" />
                            <TextBlock x:Name="IdentityText" TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind r:AppContext.AppLang.TemplateInfoDisplayNameLabel, Mode=OneWay}" />
                            <TextBlock x:Name="DisplayNameText" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Button
                        Width="200"
                        Click="OnOpenTemplateFolderClicked"
                        Content="{x:Bind r:AppContext.AppLang.TemplateOpenFolderButton, Mode=OneWay}" />
                </StackPanel>

            </PivotItem>
            <PivotItem Header="{x:Bind r:AppContext.AppLang.TemplateImportTabTitle, Mode=OneWay}">
                <StackPanel Margin="0,8,0,0" Spacing="8">
                    <TextBlock
                        Text="{x:Bind r:AppContext.AppLang.TemplateDownloadHint, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        Width="200"
                        Click="OnDownloadTemplateClicked"
                        Content="{x:Bind r:AppContext.AppLang.TemplateDownloadButton, Mode=OneWay}" />

                    <TextBlock  Text="{x:Bind r:AppContext.AppLang.TemplateImportInstruction, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnPickTemplateFileClicked" Content="{x:Bind r:AppContext.AppLang.TemplatePickFileButton, Mode=OneWay}" />
                        <TextBlock
                            x:Name="ImportFileText"
                            Text="{x:Bind r:AppContext.AppLang.TemplateNoFileSelected, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Width="160"
                        Click="OnImportTemplateClicked"
                        Content="{x:Bind r:AppContext.AppLang.TemplateImportButton, Mode=OneWay}" />
                    <Button
                        Width="200"
                        Click="OnOpenTemplateFolderClicked"
                        Content="{x:Bind r:AppContext.AppLang.TemplateOpenFolderButton, Mode=OneWay}" />
                    <TextBlock x:Name="ImportStatusText" TextWrapping="Wrap" />
                </StackPanel>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
